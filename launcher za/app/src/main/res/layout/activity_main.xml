<?xml version="1.0" encoding="utf-8" ?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_activity_root" android:focusable="true" android:focusableInTouchMode="true" android:layout_width="fill_parent" android:layout_height="fill_parent" android:background="@drawable/telainicial">

    <!-- Campo de nickname usado para entrar no servidor -->
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/nickname_input"
        android:layout_width="240dp"
        android:layout_height="46dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/rounded_button"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:hint="Nick_Sobrenome"
        android:inputType="text"
        android:maxLength="20"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="#171717"
        android:textColorHint="#777777"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Compatibilidade visual: controle antigo permanece oculto -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_switch_account"
        android:layout_width="188dp"
        android:layout_height="46dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/rounded_button"
        android:drawableStart="@drawable/launcher_google_small"
        android:drawablePadding="8dp"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="Trocar de conta"
        android:textAllCaps="false"
        android:textColor="#171717"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botões de redes sociais (canto inferior esquerdo) -->
    <LinearLayout
        android:id="@+id/social_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="30dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/button_discord"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/back_social"
            android:src="@drawable/discord_icon"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Discord" />

        <ImageButton
            android:id="@+id/button_instagram"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/back_social"
            android:src="@drawable/insta_icon"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Instagram" />

        <ImageButton
            android:id="@+id/button_youtube"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/back_social"
            android:src="@drawable/yt_icon"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="YouTube" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_play"
        android:layout_width="178dp"
        android:layout_height="48dp"
        android:layout_margin="22dp"
        android:background="@drawable/launcher_action_button"
        android:drawableStart="@drawable/launcher_update_small"
        android:drawablePadding="7dp"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="ATUALIZAR"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateDrawable="@drawable/progressbar_custom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Etapa exclusiva de login: usa exatamente o mesmo background do loading. -->
    <FrameLayout
        android:id="@+id/launcher_auth_screen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/launcher_loading_background"
        android:clickable="true"
        android:elevation="90dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/launcher_auth_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/google_login_group"
                android:layout_width="242dp"
                android:layout_height="40dp"
                android:background="@drawable/launcher_auth_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="5dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Google"
                    android:src="@drawable/launcher_google_small" />

                <TextView
                    android:id="@+id/google_account_label"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/button_google_login"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Conecte-se com o Google"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Loading modal: permanece acima de tudo e some antes da etapa de login. -->
    <FrameLayout
        android:id="@+id/launcher_loading_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/launcher_loading_background"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true"
        android:translationZ="100dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/launcher_loading_logo"
            android:layout_width="240dp"
            android:layout_height="130dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:contentDescription="Conexão Paulista"
            android:scaleType="fitCenter"
            android:src="@drawable/nexion_logo" />

        <TextView
            android:id="@+id/launcher_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="60dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Carregando o jogo"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/launcher_loading_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="58dp"
            android:layout_marginEnd="58dp"
            android:layout_marginBottom="45dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/loading_progress_bar" />

        <TextView
            android:id="@+id/launcher_loading_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Eu já li e concordo com os Termos e Política de Privacidade"
            android:textColor="#D9DDE4"
            android:textSize="6sp" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
