<?xml version="1.0" encoding="utf-8"?>
<!-- Este é um Selector que gerencia o estado pressionado e normal do botão -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado pressionado (Pressed) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <!-- Um pouco mais escuro e mais transparente ao ser pressionado -->
            <solid android:color="#60000000"/>
            <stroke android:width="2dp" android:color="#FFFFFF"/>
        </shape>
    </item>

    <!-- Estado normal (Default) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp"/>
            <!-- A mesma aparência de vidro cinza -->
            <solid android:color="#40424242"/>
            <stroke android:width="1dp" android:color="#B0FFFFFF"/>
        </shape>
    </item>
</selector>
