<?xml version="1.0" encoding="utf-8" ?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/background_loader"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/baixandodata">

    <com.akexorcist.roundcornerprogressbar.RoundCornerProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_8sdp"
        android:layout_marginStart="100dp"
        android:layout_marginEnd="100dp"
        android:layout_marginBottom="@dimen/_48sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rcBackgroundColor="#25ffffff"
        app:rcBackgroundPadding="0dp"
        app:rcMax="100.0"
        app:rcProgress="0.0"
        app:rcProgressColor="@color/gradient1"
        app:rcRadius="@dimen/_4sdp"
        app:rcReverse="false"
        app:rcSecondaryProgress="0.0"
        app:rcSecondaryProgressColor="@color/gradient2" />

    <TextView
        android:id="@+id/loading_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Atualizando arquivos"
        android:textColor="@color/white"
        android:fontFamily="@font/montserrat_bold"
        android:textSize="16sp"
        android:textStyle="italic"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintStart_toStartOf="@+id/progress_bar"
        style="@style/MontserratRegular14sp" />

    <TextView
        android:id="@+id/loading_file"
        style="@style/MontserratRegular14sp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:ellipsize="start"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="end"
        android:maxLines="1"
        android:text="Baixando: preparando... (0%)"
        android:textColor="#56A6FF"
        android:textSize="16sp"
        android:textStyle="italic"
        app:layout_constraintBottom_toTopOf="@+id/progress_bar"
        app:layout_constraintEnd_toEndOf="@+id/progress_bar"
        app:layout_constraintStart_toEndOf="@+id/loading_text" />

    <LinearLayout
        android:id="@+id/loading_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/loading_percent"
        app:layout_constraintStart_toStartOf="@+id/progress_bar"
        android:layout_marginBottom="@dimen/_17sdp">

        <ImageView
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:contentDescription="Aviso"
            android:src="@drawable/update_info_icon" />

        <TextView
            android:id="@+id/loading_warning_text"
            style="@style/MontserratRegular14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/montserrat_bold"
            android:singleLine="true"
            android:text="Evite sair do aplicativo, pois isso pode interromper o download."
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/loading_percent"
        style="@style/MontserratRegular14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="end"
        android:layout_marginBottom="@dimen/_17sdp"
        android:text="0 MB de 0 MB"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/progress_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
