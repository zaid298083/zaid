<?xml version="1.0" encoding="utf-8" ?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:id="@android:id/background">
		<shape>
			<corners android:radius="@dimen/_10sdp" />
			<gradient android:startColor="#C4AFAFAF" android:endColor="#D06A6A6A" android:angle="135" android:type="linear"/>
		</shape>
	</item>
	<item android:id="@android:id/progress">
		<scale android:scaleWidth="100%">
			<shape>
				<corners android:radius="@dimen/_10sdp" />
				<gradient android:startColor="#D964C50E" android:endColor="#D94EA636" android:angle="135" android:type="linear"/>
			</shape>
		</scale>
	</item>
</layer-list>
